# AME-AI-Sandbox 環境変数テンプレート
#
# 使い方:
#   cp .env.example .env
#   vi .env  # 値を埋める
#
# .env は git 管理対象外（.gitignore で除外済み）。

# --- GitHub 認証 -----------------------------------------------------------
# gh CLI ログイン + git HTTPS 認証に使用。Fine-grained PAT 推奨。
# `gh auth token` で取得した値を貼るか、PAT を直接記載。
GH_TOKEN=

# --- Git identity ----------------------------------------------------------
# entrypoint.sh が git config --global へ反映。
GIT_AUTHOR_NAME=your-name
GIT_AUTHOR_EMAIL=you@example.com

# --- SSH 鍵ディレクトリ（ホスト側、必須） ----------------------------------
# コンテナはここに置かれた鍵を読み取り専用で bind-mount し、
# entrypoint.sh がコンテナ内の ~/.ssh へコピーする。
# 絶対パス推奨（~ は Compose 変数展開で未解釈になる場合があります）。
SSH_HOST_DIR=/home/you/.ssh

# --- ビルド時の非 root ユーザー UID/GID（任意） -----------------------------
# ホストの UID/GID に合わせる場合に指定。既定は 1000:1000。
# USER_UID=1000
# USER_GID=1000

# --- 各 CLI の API キー（任意・対話ログインする場合は不要） ------------------
# Claude Code
# ANTHROPIC_API_KEY=

# Antigravity CLI / Gemini
# ANTIGRAVITY_API_KEY=
# GEMINI_API_KEY=
